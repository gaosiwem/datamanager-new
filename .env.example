# Copy to .env locally. Do not commit real credentials or certificate material.
MSSQL_SA_PASSWORD=replace-with-a-local-development-password
MSSQL_TLS_KEY_PASSWORD=replace-with-a-local-development-password
REDIS_PASSWORD=replace-with-a-long-random-local-password

# Public assistant safety controls.
ASSISTANT_CACHE_ENABLED=true
ASSISTANT_REQUIRE_SHARED_CACHE=true
ASSISTANT_RATE_LIMIT_PER_MINUTE=30
ASSISTANT_MAX_FOUNDRY_CALLS=4
ASSISTANT_MAX_FOUNDRY_TOKENS=1200

# Foundry configuration. Prefer certificate-backed Entra credentials in the
# on-prem production container; do not put a production private key here.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=your-deployment
AZURE_OPENAI_AUTH_MODE=entra_id
AZURE_OPENAI_ALLOWED_HOSTS=your-resource.openai.azure.com
# In production, inject AZURE_TENANT_ID, AZURE_CLIENT_ID and a read-only
# certificate path through the deployment secret manager, not this file.
AZURE_CONTENT_SAFETY_ENABLED=true
